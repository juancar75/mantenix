{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mantenix",
  "version": "0.2.0",
  "identifier": "es.mantenix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Mantenix", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../datos/semilla/": "semilla/" },
    "shortDescription": "Valoración de contratos de mantenimiento RITE/RIPCI",
    "category": "Business"
  }
}
